{
  "expo": {
    "name": "Heatlap",
    "slug": "racerpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "racerpro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Heatlap uses the camera so you can go live and share what's happening at the track.",
        "NSMicrophoneUsageDescription": "Heatlap uses the microphone so people can hear you when you go live.",
        "NSPhotoLibraryUsageDescription": "Heatlap needs access to your photos so you can add pictures and videos to posts and your profile.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "bundleIdentifier": "com.racerpro.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.racerpro.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0d",
          "dark": {
            "backgroundColor": "#0b0b0d"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Heatlap uses the camera so you can go live and share what's happening at the track.",
          "microphonePermission": "Heatlap uses the microphone so people can hear you when you go live.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Heatlap needs access to your photos so you can add pictures and videos to posts and your profile.",
          "cameraPermission": "Heatlap uses the camera so you can go live and share what's happening at the track."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Heatlap uses the camera so you can go live and share what's happening at the track.",
          "microphonePermission": "Heatlap uses the microphone so people can hear you when you go live."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#e8582f",
          "defaultChannel": "default"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e66529e3-6d0c-4071-a449-b56b3239e251"
      }
    },
    "owner": "ferrychris",
    "description": "A social network for race fans and racers: posts, friends, messages, sponsorship and live streaming."
  }
}
